# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco (PostgreSQL no docker compose)
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cockpit
# Usado pelo `npm run dev` e pelo Prisma na sua máquina. Dentro do compose,
# o app usa o host `db` (o docker-compose.yml monta a URL sozinho).
DATABASE_URL=postgresql://cockpit:troque-esta-senha@localhost:5432/cockpit

# API EVO (Basic Auth)
EVO_BASE_URL=https://evo-integracao-api.w12app.com.br
EVO_USERNAME=
EVO_PASSWORD=
